# ============================================================================
#  KONFIGURACJA - skopiuj ten plik jako ".env" i uzupełnij klucz API.
#  Plik .env NIE trafia do gita (nie wrzucaj do repozytorium kluczy!).
#  Sprawdzenie ustawień:   .venv\Scripts\python.exe -m odw.check_llm
# ============================================================================

# --- LLM: wybierz dostawcę (profile w config/llm_providers.yaml) -------------
#   ovh       OVHcloud AI Endpoints    (Francja, UE)  <- domyślny wybór dla komisji
#   scaleway  Scaleway Generative APIs (Francja, UE)
#   ionos     IONOS AI Model Hub       (Niemcy, UE)
#   mistral   Mistral AI               (Francja, UE)
#   ollama    lokalnie na tym komputerze (bez klucza)
LLM_PROVIDER=ovh

# Klucz / token API od dostawcy (dla ollama zostaw puste).
LLM_API_KEY=

# 1 = LLM uzupełnia pola, których nie znalazły regexy; 0 = tylko regexy.
# Gdy LLM jest niedostępny, aplikacja i tak działa na samych regexach.
LLM_ENABLED=1

# --- opcjonalnie: nadpisanie wartości z profilu ------------------------------
# LLM_BASE_URL=https://oai.endpoints.kepler.ai.cloud.ovh.net/v1
# LLM_MODEL=Mistral-Nemo-Instruct-2407
# LLM_TIMEOUT=60
# LLM_RETRIES=3

# --- OCR (zwykle bez zmian; wymaga zainstalowanego Tesseracta) ---------------
# TESSERACT_CMD=C:\Program Files\Tesseract-OCR\tesseract.exe
OCR_LANG=pol
# Tryb "LLM poprawia regex" (przełącznik na stronie): 0 = LLM sprawdza tylko podejrzane pola, 1 = wszystkie (może pogorszyć wynik)
# LLM_REVIEW_ALL=0
